{
  "name": "route-info-builder-docs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/build-llms-txt.mjs",
    "dev": "astro dev",
    "build": "pnpm og:compile && astro build",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit",
    "lint": "markdownlint-cli2 \"src/content/docs/**/*.{md,mdx}\"",
    "qa": "node scripts/qa-screenshots.mjs",
    "og:compile": "./node_modules/.bin/esbuild src/og-render.jsx --loader:.jsx=jsx --jsx=automatic --format=esm --outfile=src/og-render.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.10",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0",
    "linkedom": "^0.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/roboto": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro-takumi": "github:elcoosp/astro-takumi#c4b8331abb1dc2f157d62fba634eeb17f5e689cd",
    "esbuild": "^0.28.2",
    "markdownlint-cli2": "^0.24.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
